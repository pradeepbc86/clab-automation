!
! Generated by clab-automation — DO NOT EDIT by hand
! Device: {{ device.name }}  Platform: frr  ASN: {{ device.asn }}
!
hostname {{ device.name }}
!
{%- if device.loopback is defined %}
interface lo
 ip address {{ device.loopback }}
!
{%- endif %}
{%- if device.interfaces is defined %}
{%- for iface in device.interfaces %}
interface {{ iface.name }}
{%- if iface.description is defined %}
 description {{ iface.description }}
{%- endif %}
{%- if iface.ip is defined %}
 ip address {{ iface.ip }}
{%- endif %}
{%- if iface.mtu is defined %}
 mtu {{ iface.mtu }}
{%- endif %}
!
{%- endfor %}
{%- endif %}
{%- if device.policies is defined %}
{%- if device.policies.prefix_lists is defined %}
{%- for pl in device.policies.prefix_lists %}
{%- for e in pl.entries %}
ip prefix-list {{ pl.name }} seq {{ e.seq }} {{ e.action }} {{ e.prefix }}
        {%- if e.ge is defined %} ge {{ e.ge }}{% endif %}
        {%- if e.le is defined %} le {{ e.le }}{% endif %}
{%- endfor %}
!
{%- endfor %}
{%- endif %}
{%- if device.policies.route_maps is defined %}
{%- for rm in device.policies.route_maps %}
{%- for e in rm.entries %}
route-map {{ rm.name }} {{ e.action }} {{ e.seq }}
{%- if e.match_prefix_list is defined %}
 match ip address prefix-list {{ e.match_prefix_list }}
{%- endif %}
{%- if e.set_local_preference is defined %}
 set local-preference {{ e.set_local_preference }}
{%- endif %}
{%- if e.set_community is defined %}
 set community {{ e.set_community }}
{%- endif %}
{%- if e.set_large_community is defined %}
 set large-community {{ e.set_large_community }}
{%- endif %}
{%- if e.set_as_path_prepend is defined %}
 set as-path prepend {{ e.set_as_path_prepend }}
{%- endif %}
{%- endfor %}
!
{%- endfor %}
{%- endif %}
{%- endif %}
router bgp {{ device.asn }}
 bgp router-id {{ device.router_id }}
 bgp log-neighbor-changes
 bgp bestpath as-path multipath-relax
 no bgp default ipv4-unicast
{%- if device.graceful_restart is defined and device.graceful_restart.enabled %}
 !
 bgp graceful-restart
{%- if device.graceful_restart.preserve_fw_state %}
 bgp graceful-restart preserve-fw-state
{%- endif %}
 bgp graceful-restart stalepath-time {{ device.graceful_restart.stalepath_time }}
 bgp graceful-restart restart-time {{ device.graceful_restart.restart_time }}
 bgp graceful-restart notification
{%- endif %}
{%- set peer_groups = [] %}
{%- for p in device.peers %}
{%- if p.group is defined and p.group not in peer_groups %}
{%- set _ = peer_groups.append(p.group) %}
{%- endif %}
{%- endfor %}
{%- for grp in peer_groups %}
 !
 neighbor {{ grp }} peer-group
{%- set first = device.peers | selectattr('group', 'equalto', grp) | list | first %}
 neighbor {{ grp }} remote-as external
 neighbor {{ grp }} timers 3 9
 neighbor {{ grp }} timers connect 5
{%- if first.bfd is defined and first.bfd %}
 neighbor {{ grp }} bfd
{%- if device.bfd_profile is defined %}
 neighbor {{ grp }} bfd profile {{ device.bfd_profile.name }}
{%- endif %}
{%- endif %}
{%- endfor %}
 !
{%- for peer in device.peers %}
{%- if peer.group is defined %}
 neighbor {{ peer.ip }} peer-group {{ peer.group }}
 neighbor {{ peer.ip }} remote-as {{ peer.asn }}
{%- else %}
 neighbor {{ peer.ip }} remote-as {{ peer.asn }}
{%- endif %}
 neighbor {{ peer.ip }} description {{ peer.description }}
{%- endfor %}
 !
 address-family ipv4 unicast
{%- for grp in peer_groups %}
  neighbor {{ grp }} activate
{%- set first = device.peers | selectattr('group', 'equalto', grp) | list | first %}
{%- if first.max_prefix is defined %}
  neighbor {{ grp }} maximum-prefix {{ first.max_prefix }} 80 restart 5
{%- endif %}
{%- if first.route_map_in is defined %}
  neighbor {{ grp }} route-map {{ first.route_map_in }} in
{%- endif %}
{%- if first.route_map_out is defined %}
  neighbor {{ grp }} route-map {{ first.route_map_out }} out
{%- endif %}
{%- endfor %}
{%- for peer in device.peers if peer.group is not defined %}
  neighbor {{ peer.ip }} activate
{%- if peer.max_prefix is defined %}
  neighbor {{ peer.ip }} maximum-prefix {{ peer.max_prefix }} 80 restart 5
{%- endif %}
{%- if peer.route_map_in is defined %}
  neighbor {{ peer.ip }} route-map {{ peer.route_map_in }} in
{%- endif %}
{%- if peer.route_map_out is defined %}
  neighbor {{ peer.ip }} route-map {{ peer.route_map_out }} out
{%- endif %}
{%- endfor %}
{%- if device.loopback is defined %}
  network {{ device.loopback }}
{%- endif %}
  maximum-paths 64
 exit-address-family
{%- if device.evpn is defined and device.evpn.enabled %}
 !
 address-family l2vpn evpn
{%- for grp in peer_groups %}
  neighbor {{ grp }} activate
{%- endfor %}
{%- if device.evpn.advertise_all_vni %}
  advertise-all-vni
{%- endif %}
{%- if device.evpn.advertise_default_gw %}
  advertise-default-gw
{%- endif %}
 exit-address-family
{%- endif %}
!
{%- if device.bfd_profile is defined %}
bfd
 profile {{ device.bfd_profile.name }}
  detect-multiplier {{ device.bfd_profile.detect_multiplier }}
  receive-interval {{ device.bfd_profile.receive_interval }}
  transmit-interval {{ device.bfd_profile.transmit_interval }}
!
{%- endif %}
