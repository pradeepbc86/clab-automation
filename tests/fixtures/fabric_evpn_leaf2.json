{
  "name": "leaf2",
  "platform": "frr",
  "asn": 4200000004,
  "router_id": "10.0.0.4",
  "loopback": "10.0.0.4/32",
  "interfaces": [
    {"name": "eth1", "ip": "10.10.2.2/30", "description": "to spine1", "mtu": 9216},
    {"name": "eth2", "ip": "10.10.4.2/30", "description": "to spine2", "mtu": 9216},
    {"name": "eth0", "ip": "10.10.5.2/30", "description": "to leaf1",  "mtu": 9216}
  ],
  "peers": [
    {
      "ip": "10.10.2.1", "asn": 4200000001, "description": "spine1",
      "group": "SPINES", "max_prefix": 1000, "bfd": true,
      "route_map_in": "RM-SPINES-IN", "route_map_out": "RM-SPINES-OUT"
    },
    {
      "ip": "10.10.4.1", "asn": 4200000002, "description": "spine2",
      "group": "SPINES", "max_prefix": 1000, "bfd": true,
      "route_map_in": "RM-SPINES-IN", "route_map_out": "RM-SPINES-OUT"
    }
  ],
  "bfd_profile": {"name": "FABRIC", "detect_multiplier": 3, "receive_interval": 150, "transmit_interval": 150},
  "graceful_restart": {"enabled": true, "preserve_fw_state": true, "stalepath_time": 300, "restart_time": 120},
  "evpn": {
    "enabled": true,
    "advertise_all_vni": true,
    "advertise_default_gw": true,
    "vnis": [{"id": 10, "type": "L2", "vxlan_if": "vxlan10"}]
  },
  "policies": {
    "prefix_lists": [
      {"name": "PL-FABRIC-LOOPBACKS", "entries": [
        {"seq": 10, "action": "permit", "prefix": "10.0.0.0/24", "le": 32}
      ]},
      {"name": "PL-FABRIC-CONNECTED", "entries": [
        {"seq": 10, "action": "permit", "prefix": "10.0.0.4/32"}
      ]}
    ],
    "route_maps": [
      {"name": "RM-SPINES-IN", "entries": [
        {"seq": 10, "action": "permit", "match_prefix_list": "PL-FABRIC-LOOPBACKS"}
      ]},
      {"name": "RM-SPINES-OUT", "entries": [
        {"seq": 10, "action": "permit", "match_prefix_list": "PL-FABRIC-CONNECTED"}
      ]}
    ]
  }
}
